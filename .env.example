# ---------------------------------------------------------------------------
# Scoreboard System environment. Copy to .env and edit. Never commit .env.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Public origin of the app (used for CORS and cookie security). Must be https in production.
APP_ORIGIN=http://localhost:5173
# Set to true when behind Caddy / a load balancer so client IPs and https are detected.
TRUST_PROXY=false
# Directory of the built web app that the server serves in production.
WEB_DIST_DIR=../web/dist

# --- Database --------------------------------------------------------------
# Local dev (scripts/db-local.sh) uses port 54329. docker-compose overrides this.
DATABASE_URL=postgresql://scoreboard:scoreboard@localhost:54329/scoreboard?schema=public
# Separate database used by the server integration tests.
TEST_DATABASE_URL=postgresql://scoreboard:scoreboard@localhost:54329/scoreboard_test?schema=public
# Database the Playwright smoke suite seeds and runs against (defaults to TEST_DATABASE_URL with _e2e).
E2E_DATABASE_URL=postgresql://scoreboard:scoreboard@localhost:54329/scoreboard_e2e?schema=public
# Used by docker-compose to create the PostgreSQL container.
POSTGRES_DB=scoreboard
POSTGRES_USER=scoreboard
POSTGRES_PASSWORD=change-me-strong-password

# --- Security --------------------------------------------------------------
# 32+ random characters. Signs session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Seeded admin account (created on first seed / first boot if missing).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
# Venue-wide controller PIN that referees enter once per tablet.
CONTROLLER_PIN=1234
# Session lifetime in hours.
SESSION_TTL_HOURS=72

# --- Venue -----------------------------------------------------------------
VENUE_NAME="Demo Volleyball Centre"
VENUE_TIMEZONE=Australia/Sydney

# --- Deployment (docker-compose / Caddy) -----------------------------------
# Public hostname for automatic HTTPS. Use "localhost" for a local self-signed cert.
SITE_ADDRESS=localhost
# Leave empty on a public host. For an on-premises server with a LAN hostname set to "tls internal"
# (Caddy issues certificates from its own CA; install that CA on kiosks/tablets, docs/DEPLOY.md §7).
CADDY_TLS=
# Build label shown in the UI and used for auto-reload detection.
APP_VERSION=dev
# Seed demo data when the container starts (only for demos).
SEED_ON_BOOT=false

# --- Optional integrations -------------------------------------------------
# "Post to Facebook" on Admin → Ladders uploads the ladder PNG snapshot to a Facebook Page via the
# Graph API. Leave FACEBOOK_ENABLED=false to hide the button entirely. See docs/DEPLOY.md §8 for
# how to obtain a long-lived Page access token (needs pages_manage_posts + pages_read_engagement).
FACEBOOK_ENABLED=false
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
